{
  "name": "uifiles",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "lint": "biome check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "registry:sync": "node scripts/sync-tokens.ts && node scripts/generate-aliases.ts",
    "registry:validate": "shadcn registry validate",
    "registry:build": "node scripts/sync-tokens.ts && shadcn registry validate && shadcn build",
    "gate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm registry:validate && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.117",
