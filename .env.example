# Public origin of the deployed site. It is baked into `/` (install commands)
# and `/llms.txt` (every item URL) at build time. On Vercel it may be left
# unset: the build falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL,
# and a production build that would still resolve to localhost fails. Any
# other hosted deploy must set it: off Vercel a production build that resolves
# to localhost only warns, so that a local `pnpm build` keeps working.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
